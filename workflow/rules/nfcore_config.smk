rule nfcore_config:
    input:
        # one representative file per index to enforce all indexes are built first
        fasta=expand(OUTDIR + "/{genome}/genome.fa", genome=genomes.index),
        fasta_fai=expand(OUTDIR + "/{genome}/genome.fa.fai", genome=genomes.index),
        dict=expand(OUTDIR + "/{genome}/genome.dict", genome=genomes.index),
        gtf=expand(OUTDIR + "/{genome}/annotation.gtf", genome=genomes.index),
        gff3=expand(OUTDIR + "/{genome}/annotation.gff3", genome=genomes.index),
        transcript_fasta=expand(OUTDIR + "/{genome}/transcripts.fa", genome=genomes.index),
        tx2gene=expand(OUTDIR + "/{genome}/tx2gene.csv", genome=genomes.index),
        star=expand(OUTDIR + "/{genome}/star", genome=genomes.index),
        minimap2=expand(OUTDIR + "/{genome}/minimap2/genome.mmi", genome=genomes.index),
        bismark=expand(OUTDIR + "/{genome}/bismark/Bisulfite_Genome", genome=genomes.index),
        hisat2=expand(OUTDIR + "/{genome}/hisat2/genome.1.ht2l", genome=genomes.index),
        bowtie2=expand(OUTDIR + "/{genome}/bowtie2/genome.1.bt2", genome=genomes.index),
        bwa=expand(OUTDIR + "/{genome}/bwa-mem/genome.amb", genome=genomes.index),
        bwamem2=expand(OUTDIR + "/{genome}/bwa-mem2/genome.0123", genome=genomes.index),
        salmon=expand(OUTDIR + "/{genome}/salmon/info.json", genome=genomes.index),
    output:
        OUTDIR + "/nfcore_genomes.config",
    run:
        import os

        # derive outdir from the output path to avoid relying on global OUTDIR in run block
        config_path = os.path.abspath(output[0])
        outdir = os.path.dirname(config_path)

        header = (
            "/*\n"
            "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
            "    Nextflow config file for genome index paths\n"
            "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
            "    Generated by smk-indexer. Use with nf-core pipelines by adding to your\n"
            "    Nextflow command:\n"
            f"        -c {config_path}\n"
            "----------------------------------------------------------------------------------------\n"
            "*/\n"
            "\n"
            "params {\n"
            "    genomes {\n"
        )

        with open(output[0], "w") as fh:
            fh.write(header)
            for genome in genomes.index:
                gdir = f"{outdir}/{genome}"
                fh.write(f"        '{genome}' {{\n")
                fh.write(f"            fasta            = \"{gdir}/genome.fa\"\n")
                fh.write(f"            fasta_fai        = \"{gdir}/genome.fa.fai\"\n")
                fh.write(f"            dict             = \"{gdir}/genome.dict\"\n")
                fh.write(f"            gtf              = \"{gdir}/annotation.gtf\"\n")
                fh.write(f"            gff3             = \"{gdir}/annotation.gff3\"\n")
                fh.write(f"            transcript_fasta = \"{gdir}/transcripts.fa\"\n")
                fh.write(f"            tx2gene          = \"{gdir}/tx2gene.csv\"\n")
                fh.write(f"            star             = \"{gdir}/star/\"\n")
                fh.write(f"            hisat2           = \"{gdir}/hisat2/\"\n")
                fh.write(f"            bismark          = \"{gdir}/bismark/\"\n")
                fh.write(f"            bowtie2          = \"{gdir}/bowtie2/\"\n")
                fh.write(f"            bwa              = \"{gdir}/bwa-mem/\"\n")
                fh.write(f"            bwamem2          = \"{gdir}/bwa-mem2/\"\n")
                fh.write(f"            minimap2         = \"{gdir}/minimap2/genome.mmi\"\n")
                fh.write(f"            salmon           = \"{gdir}/salmon/\"\n")
                fh.write(f"        }}\n")
            fh.write("    }\n}\n")
